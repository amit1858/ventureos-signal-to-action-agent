# Signal-to-Action Agent -- example environment (non-secret documentation only).
#
# Copy to `.env` and fill in real values locally. Never commit secrets. Every
# variable below is read once at startup via config.py. Unset variables fall
# back to the safe defaults shown here.

# -- Adaptive Mission Harness host mount (Release 2.2) --------------------
#
# The governed Adaptive Mission Harness is exposed to this API as an isolated,
# transport-only sub-application ONLY when explicitly enabled. It is OFF by
# default so existing behaviour is unchanged. When enabled it is mounted at
# `/api/harness`, exposing the single public route `POST /api/harness/missions`.
# Execution is SIMULATED only -- no real messages are sent and no external
# system is written.
#
# HARNESS_MOUNT_ENABLED=true mounts the harness sub-app. Default: false.
HARNESS_MOUNT_ENABLED=false
#
# HARNESS_LEDGER_PATH is the DEDICATED SQLite audit ledger for the harness. It
# MUST be distinct from DB_PATH (the decision ledger); the mount refuses to
# start if they collide. Default: services/api/harness_audit.db
# HARNESS_LEDGER_PATH=harness_audit.db
#
# HARNESS_SERVICE_TOKEN is the shared secret the Next.js BFF must present as the
# `X-Harness-Service-Token` header on every call to the mounted harness. It is
# server-only (never a NEXT_PUBLIC_ value), compared in constant time, and never
# logged or returned. When the mount is enabled this token is REQUIRED -- the
# mount fails closed without it.
# HARNESS_SERVICE_TOKEN=
#
# HARNESS_ALLOW_INSECURE_LOCAL=true is the ONLY sanctioned way to run the mount
# without a service token, for local testing only. Never enable in production.
HARNESS_ALLOW_INSECURE_LOCAL=false
