# Base URL of the FastAPI backend. The frontend reads this at build/runtime.
# Copy this file to .env.local and adjust if your API runs elsewhere.
# In production (e.g. Vercel) set this to your deployed backend URL
# (Render / Railway / Azure App Service); do not rely on localhost.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Optional: display name for the Executive Morning Brief greeting
# ("Good Morning <First Name> 👋"). Leave unset to show the greeting with no
# name. This is never hardcoded in the app; it is resolved at runtime from a
# local-only override (localStorage "s2a_display_name") or this build-time env.
# NEXT_PUBLIC_USER_NAME=


# --- Soul Machines Manager Coach (experimental POC) ------------------------
# Feature flag for the isolated Manager Coach avatar POC. The entry card and the
# /manager-coach/avatar-poc route only appear when this is exactly "true".
# Leave as "false" (or unset) to keep the POC fully disabled - no Soul Machines
# resources load and the route returns 404.
NEXT_PUBLIC_ENABLE_SOUL_MACHINES_POC=false

# Soul Machines hosted assistant URL (presentation only). This is the shareable,
# token-scoped assistant experience - NOT a long-lived API key. Must be an https
# URL on a soulmachines.com host or it is rejected (fail closed). When unset, the
# POC shows a "configuration missing" state.
# NEXT_PUBLIC_SOUL_MACHINES_ASSISTANT_URL=https://workforce.soulmachines.com/assistant?t=YOUR_ASSISTANT_TOKEN
