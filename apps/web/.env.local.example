# Base URL of the FastAPI backend. The frontend reads this at build/runtime.
# Copy this file to .env.local and adjust if your API runs elsewhere.
# In production (e.g. Vercel) set this to your deployed backend URL
# (Render / Railway / Azure App Service); do not rely on localhost.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Optional: display name for the Executive Morning Brief greeting
# ("Good Morning <First Name> 👋"). Leave unset to show the greeting with no
# name. This is never hardcoded in the app; it is resolved at runtime from a
# local-only override (localStorage "s2a_display_name") or this build-time env.
# NEXT_PUBLIC_USER_NAME=

# --- Release 2.4 - NVIDIA-Grounded Mission Intelligence · Hosted NIM (SERVER-ONLY) ---
# All variables below are read ONLY on the server (never NEXT_PUBLIC_*). They
# control the post-decision, presentation-only grounded-narrative layer. NVIDIA
# output can NEVER change a mission decision, action, verification, approval, or
# execution; the deterministic grounding guard vets every live narrative and the
# flow fails closed to the deterministic VentureOS baseline on any problem.
#
# Provider selection. "mock" (default) uses the deterministic grounded-narrative
# generator - no network, no key. "nim" calls a hosted NVIDIA Nemotron model.
# (Legacy alias NVIDIA_NARRATIVE_MODE is still honoured when NVIDIA_PROVIDER is
# unset.)
# NVIDIA_PROVIDER=mock
#
# Audience the narrative language targets (presentation only).
# NVIDIA_NARRATIVE_AUDIENCE=business
#
# Hosted NIM configuration (required only when NVIDIA_PROVIDER=nim). If any is
# missing the layer degrades to the deterministic fallback. The API key is never
# logged, never returned in errors, and never sent to the browser. Do NOT commit
# a real key - put real values in .env.local (gitignored), not in this example.
# NVIDIA_API_BASE_URL=https://integrate.api.nvidia.com/v1
# NVIDIA_API_KEY=
# NVIDIA_MODEL=nvidia/nvidia-nemotron-nano-9b-v2
# NVIDIA_TIMEOUT_MS=30000
# NVIDIA_MAX_RETRIES=1
# Hard ceiling (ms) on TOTAL wall time across attempts. Defaults to
# NVIDIA_TIMEOUT_MS so a slow/hung model can never block the mission experience
# for roughly two full timeouts; a retry only runs inside the remaining budget.
# NVIDIA_TOTAL_BUDGET_MS=30000

