# Base URL of the FastAPI backend. The frontend reads this at build/runtime.
# Copy this file to .env.local and adjust if your API runs elsewhere.
# In production (e.g. Vercel) set this to your deployed backend URL
# (Render / Railway / Azure App Service); do not rely on localhost.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Optional: display name for the Executive Morning Brief greeting
# ("Good Morning <First Name> 👋"). Leave unset to show the greeting with no
# name. This is never hardcoded in the app; it is resolved at runtime from a
# local-only override (localStorage "s2a_display_name") or this build-time env.
# NEXT_PUBLIC_USER_NAME=

# --- Release 2.3 - NVIDIA-Grounded Mission Intelligence (SERVER-ONLY) ---
# Read ONLY on the server (never NEXT_PUBLIC_*). Controls the post-decision,
# presentation-only grounded narrative layer. NVIDIA output can never change a
# mission decision, action, verification, approval, or execution.
#
# Provider mode: "mock" (default) uses the deterministic grounded-narrative
# generator - no network, no key. "nim" is declared but NOT implemented in this
# slice and fails closed to the deterministic VentureOS baseline.
# NVIDIA_NARRATIVE_MODE=mock
#
# Audience the narrative language targets (presentation only).
# NVIDIA_NARRATIVE_AUDIENCE=business
#
# Reserved for a FUTURE live NVIDIA NIM path only. Leave unset this release; it
# is never sent to the browser and is unused by the mock provider.
# NVIDIA_API_KEY=
